<!DOCTYPE html>
<html lang="en">
    <head>
        
        <title>Ver docencias - ASD</title>
        <!--Cabecera de head-->
        <%- include('Plantillas/plantilla-head-html.ejs') %>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/css/select2.min.css" rel="stylesheet">
        <link href="https://cdn.datatables.net/2.0.2/css/dataTables.dataTables.css" rel="stylesheet" />
        </head>
    <body class="sb-nav-fixed">
        <!--barra de navegacion -->
        <%- include('Plantillas/plantilla-nav-var.ejs') %>
        <div id="layoutSidenav">
            <!-- Plantilla de sidevar-->
            <%- include('Plantillas/plantilla-layout-sidevar.ejs')%>
            <div id="layoutSidenav_content">
                <main>
                    <div class="container-fluid px-4">
                        <ol class="breadcrumb mb-4 py-4">
                            <li class="breadcrumb-item"><a href="/">Página principal</a></li>
                            <li class="breadcrumb-item active">Ver docencias</li>
                        </ol>
                        <div class="card mb-4">
                            <div class="card-header">
                                <i class="fas fa-table me-1"></i>
                                Docencias del día
                            </div>
                            <div class="card-body">
                                <table id="datatable" class="w-100">
                                    <div class="py-2">
                                        <label for="date-filter">Fecha</label>
                                        <input class="datatable-selector" type="date" id="date-filter" name="date-filter" value="<%= fecha %>" min="2023-09-11" max="<%= fecha_max %>" />
                                        <label for="status-filter">Filtrar por</label>
                                        <select class="select datatable-selector dt-status-filter" id="status-filter">
                                            <option value="Todas">Todas</option>
                                            <% valores_asist.forEach(function(val) { %>
                                                <option value="<%= val %>"><%= val %></option>
                                            <% }); %>
                                        </select>
                                        <a id="btn-descargar" href="#" class="btn btn-primary">
                                            Descargar PDF
                                        </a>                                            
                                    </div>
                                    <div class="justify-content-between" style="display: none;" id="mensaje_carga"> <h5>Cargando datos...</h5> </div>
                                    <thead>
                                        <tr>
                                            <th>Hora</th>
                                            <th>Espacio</th>
                                            <th>Clase</th>
                                            <th>Docente</th>
                                            <th>Estado</th>
                                            <th>Motivo</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% asistencias.forEach(function(asistencia) { %>
                                            <tr>
                                                <td><%= asistencia.hora %></td>
                                                <td><%= asistencia.espacio %></td>
                                                <td><%= asistencia.clase %></td>
                                                <td><%= asistencia.docente %></td>
                                                <td><%= asistencia.estado %></td>
                                                <td><%= asistencia.motivo %></td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
        <script src="../assets/js/scripts.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.datatables.net/2.0.2/js/dataTables.js"></script>
        <script src="../assets/js/filtro-asistencias-bundle.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/js/select2.min.js"></script>
        <script> 
            $(document).ready(function() {
                // Initialize Select2
                var select2 = $('.select').select2();
            });
        </script>
        <script>
            $(document).ready(function () {
                function updatePDFLink() {
                    // Obtén los valores de los filtros
                    const fecha = $('#date-filter').val();
                    const estado = $('#status-filter').val();

                    // Genera la URL dinámica para el PDF
                    const url = `/reporte-docencias/pdf?fecha=${encodeURIComponent(fecha)}&estado=${encodeURIComponent(estado)}`;

                    // Actualiza el atributo href del botón
                    $('#btn-descargar').attr('href', url);
                }

                // Actualiza el enlace cuando cambian los filtros
                $('#status-filter, #date-filter').on('change', updatePDFLink);

                // También actualiza el enlace al cargar la página
                updatePDFLink();
            });
        </script>
        
    </body>
</html>
