<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Registrar firmas - ASD</title>
                <!--Cabecera comun de head-->
        <%- include('Plantillas/plantilla-head-html.ejs') %>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/css/select2.min.css" rel="stylesheet">
        <link href="https://cdn.datatables.net/2.0.2/css/dataTables.dataTables.css" rel="stylesheet" />
        
    </head>
    <body class="sb-nav-fixed">
        <!--barra de navegacion -->
        <%- include('Plantillas/plantilla-nav-var.ejs') %>
        <div id="layoutSidenav">
            <!-- Plantilla de sidevar-->
            <%- include('Plantillas/plantilla-layout-sidevar.ejs')%>
            <div id="layoutSidenav_content">
                <main>
                    <div class="container-fluid px-4 py-4">
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item"><a href="/">Página principal</a></li>
                            <li class="breadcrumb-item active">Registrar firmas</li>
                        </ol>
                        <div class="card mb-4">
                            <div class="card-header">
                                <i class="fas fa-table me-1"></i>
                                Docencias del día
                            </div>
                            <div class="card-body">
                                <h3>Filtros</h3>
                                <div class="py-2 justify-content-between">
                                    <form method="post">
                                        <input type="hidden" name="postType" value="filtro"/>
                                        <label class="ms-2 me-1" for="date-filter">Fecha</label>
                                        <input class="datatable-selector" type="date" id="date-filter" name="fecha" value="<%= fecha %>" min="2023-09-11" max="2030-07-31" />
                                        <label class="ms-2 me-1" for="espacio-filter">Espacio</label>
                                        <select class="select datatable-selector dt-status-filter" id="espacio-filter" name="espacio">
                                            <% espacios.forEach(function(espacio) { %>
                                                <% if (espacio.seleccionado) { %>
                                                    <option value="<%= espacio.id %>" selected="selected"><%= espacio.nombre %></option>
                                                <% } else { %>
                                                    <option value="<%= espacio.id %>"><%= espacio.nombre %></option>
                                                <% } %>
                                            <% }); %>
                                        </select>
                                        <button class="btn btn-primary" id="filter-button" type="submit"> Filtrar </button>
                                    </form>
                                </div>
                                <div class="justify-content-between"  style="display: none;" id="mensaje_carga"> <h5> Cargando datos... </h5> </div>
                                <table id="datatable" class="w-100">
                                    <thead>
                                        <tr>
                                            <th>Hora</th>
                                            <th>Clase</th>
                                            <th>Docente</th>
                                            <th>Sustituto</th>
                                            <th>Ha firmado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% for (let i = 0; i < clases.length; i++) { %>
                                        <% let clase = clases[i]; %>
                                            <tr>
                                                <form method="post" id="post<%= i %>">
                                                    <input type="hidden" name="postType" value="firma"/>
                                                    <input type="hidden" name="pos" value="<%= i %>"/>
                                                    <td name="hora" value="<%= clase.hora %>"><%= clase.hora %></td>
                                                    <td name="clase" value="<%= clase.clase %>"><%= clase.clase %></td>
                                                    <td name="docente" value="<%= clase.docente %>"><%= clase.docente %></td>
                                                    <td>
                                                        <div class="justify-content-between">
                                                            <select class="select form-control w-75" id="sustituto_filter<%= i %>" name="sustituto">
                                                                <option value="no">No hay sustituto</option>
                                                                <% docentes.forEach(function(docente) { %>
                                                                    <option value="<%= docente %>"><%= docente %></option>
                                                                <% }); %>
                                                            </select>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="form-check">
                                                            <button class="btn btn-success p-0 align-items-center" style="width:40px;height:28px" type="submit" value="" id="registrar<%= i %>">
                                                                <img src="../assets/Tick Form.svg">
                                                            </button>
                                                        </div>
                                                    </td>
                                                </form>
                                            </tr>
                                        <% } %>                        
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
        <script src="../assets/js/scripts.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.datatables.net/2.0.2/js/dataTables.js"></script>
        <script src="../assets/js/datatables-demo.min.js"></script>
        <script src="../assets/js/filtro-firmas.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/js/select2.min.js"></script>
        <script> 
            $(document).ready(function() {
                // Initialize Select2
                var select2 = $('.select').select2();
            });
        </script>
    </body>
</html>