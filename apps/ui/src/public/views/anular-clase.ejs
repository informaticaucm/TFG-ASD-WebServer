<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Cancelar clase - ASD</title>
        <!--Cabecera de head-->
        <%- include('Plantillas/plantilla-head-html.ejs') %>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/css/select2.min.css" rel="stylesheet">
    </head>
    <body class="sb-nav-fixed">
        <!--barra de navegacion -->
        <%- include('Plantillas/plantilla-nav-var.ejs') %>
        <div id="layoutSidenav">
            <!-- Plantilla de sidevar-->
            <%- include(Plantillas/plantilla-layout.sidevar.ejs)%>
            <div id="layoutSidenav_content">
                <main>
                    <!-- espacio necesario para que el navbar no se coma parte de los datos -->
                    <div class="container-fluid px-4"> 
                        <ol class="breadcrumb mb-4 py-4">
                            <li class="breadcrumb-item"><a href="/">Página principal</a></li>
                            <li class="breadcrumb-item active">Cancelar una clase</li>
                        </ol>
                        <div class="row justify-content-center" id="feature-div">
                        <!-- separar de arriba, en xs 11 columnas, en s 10 columnas, etc. -->
                            <div class="col-11 col-sm-10 col-md-8 col-lg-6">
                                <div class="card shadow-lg border-0 rounded-lg mt-5">
                                    <div class="card-header"><h3 class="text-center font-weight-light my-3">Cancelación</h3></div>
                                    <div class="card-body">
                                        <% if (typeof error != 'undefined') { %>
                                        <p class="text-error"><%= error.error %></p>
                                        <% } %>
                                        <form method="post"> 
                                            <p>Datos clase a cancelar</p>
                                            <div class="form-floating mb-3">
                                                <input type="date" class="form-control" id="meeting_time" name="meeting_time" value="<%= fecha.hoy %>" min="<%= fecha.hoy %>" max="<%= fecha.max %>"/>
                                                <label for="meeting-time">Fecha</label>
                                            </div>
                                            <div class="form-floating mb-3">
                                                <select class="select form-control" id="clase_filter" name="clase_filter" required>
                                                    <% clases.forEach(function(clase) { %>
                                                        <option value="<%= clase.id %> <%= clase.nombre %>" fecha="<%= clase.fecha %>" ><%= clase.nombre %></option>
                                                    <% }); %>
                                                </select>
                                                <label for="clase-filter">Asignatura y Grupo</label>
                                            </div>
                                            <p>Motivo</p>
                                            <div class="form-floating mb-3">
                                                <input class="form-control" id="motivo" type="text" name="motivo" required/>
                                                <label for="motivo">Motivo</label>
                                            </div>
                                            <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                                <a class="btn btn-primary" href="/">Atrás</a>
                                                <button class="btn btn-primary" type="submit">Solicitar</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
        <script src="../assets/js/scripts.min.js"></script>
        <script src="../assets/js/script-filtro-fecha.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/js/select2.min.js"></script>
        <script>
            $(document).ready(function() {
                // Initialize Select2
                let select2 = $('.select').select2();

                $('#trigger').on('change', function() {
                    //Pillar valor de meeting_time $(#meeting_time).value()

                    
                })


            
                $('#trigger').on('change', function() {
                    var selectedType = $(this).val(); // Get the selected type

                    $('#mySelect option').each(function() {
                        var optionType = $(this).data('type'); // Get the type of each option
                        if (optionType !== selectedType) {
                            $(this).css('display', 'none'); // Hide options not matching the selected type
                        } else {
                            $(this).css('display', ''); // Show options matching the selected type
                        }
                    });

                    $('#mySelect').trigger('change.select2'); // Trigger change event for Select2 to update
                })
        });
        </script>
    </body>
</html>