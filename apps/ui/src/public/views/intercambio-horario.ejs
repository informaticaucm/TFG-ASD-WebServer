<!DOCTYPE html>
<html lang="es">
    <head>
        <title>Gestión de intercambio de clases - ASD</title>
        <%- include('Plantillas/plantilla-head-html.ejs') %>
        <link href="https://cdn.datatables.net/2.0.2/css/dataTables.dataTables.css" rel="stylesheet" />
    </head>
    <body class="sb-nav-fixed">
        <%- include('Plantillas/plantilla-nav-var.ejs') %>
        <div id="layoutSidenav">
            <%- include('Plantillas/plantilla-layout-sidevar.ejs') %>
            <div id="layoutSidenav_content">
                <main>
                    <div class="container-fluid px-4">
                        <ol class="breadcrumb mb-4 py-4">
                            <li class="breadcrumb-item"><a href="/">Página principal</a></li>
                            <li class="breadcrumb-item"><a href="/gestion-cambio-clase">Gestión de cambio de clases</a></li>
                            <li class="breadcrumb-item active">Intercambio de clase organizado</li>
                        </ol>
                        <div class="row justify-content-center" id="feature-div">
                            <div class="col-11 col-sm-10 col-md-8 col-lg-6">
                                <div class="card shadow-lg border-0 rounded-lg mt-5">
                                    <div class="card-header">
                                        <h3 class="text-center font-weight-light my-3">Cambio de horario</h3>
                                    </div>
                                    <div class="card-body">
                                        <% if (typeof error != 'undefined') { %>
                                            <p class="text-error"><%= error.error %></p>
                                        <% } %>
                                        <form method="post">
                                            <p>Datos clase a cambiar</p>
                                            <div class="form-floating mb-3">
                                                <input type="date" class="form-control" id="meeting_time" name="meeting_time" value="<%= fecha.hoy %>" min="<%= fecha.hoy %>" max="<%= fecha.max %>"/>
                                                <label for="meeting_time">Fecha</label>
                                            </div>

                                            <div class="form-floating mb-3">
                                                <select class="form-control" id="actividadId" name="actividadId" required>
                                                    <% clases.forEach(function(clase) { %>
                                                        <option 
                                                            value="<%= clase.id %>"
                                                            meeting_fecha="<%= clase.fecha%>"> 
                                                            <%= clase.nombre %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                                <label for="actividadId">Asignatura y Grupo</label>
                                            </div>
                                            <div id="no-clases-msg" class="text-danger mb-3" style="display: none;">
                                                No hay asignaturas disponibles para la fecha seleccionada.
                                            </div>

                                            <p>Motivo</p>
                                            <div class="form-floating mb-3">
                                                <input class="form-control" id="motivo" type="text" name="motivo" required/>
                                                <label for="motivo">Motivo</label>
                                            </div>

                                            <p>Datos clase de sustitución</p>
                                            <div class="form-floating mb-3">
                                                <input type="date" class="form-control" id="nueva_fecha" name="nueva_fecha" value="<%= fecha.hoy %>" min="<%= fecha.hoy %>" max="<%= fecha.max %>"/>
                                                <label for="nueva_fecha">Fecha</label>
                                            </div>
                                            <div class="form-floating mb-3">
                                                <input type="time" class="form-control" id="nueva_hora_inicio" name="nueva_hora_inicio" value="<%= fecha.hora_inicio %>" min="<%= fecha.hora_inicio %>" max="<%= fecha.hora_fin %>"/>
                                                <label for="nueva_hora_inicio">Hora de inicio</label>
                                            </div>
                                            <div class="form-floating mb-3">
                                                <input type="time" class="form-control" id="nueva_hora_fin" name="nueva_hora_fin" value="<%= fecha.hora_fin %>" min="<%= fecha.hora_inicio %>" max="<%= fecha.hora_fin %>"/>
                                                <label for="nueva_hora_fin">Hora de fin</label>
                                            </div>

                                            <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                                <a class="btn btn-primary" href="/">Atrás</a>
                                                <button class="btn btn-primary" type="submit">Solicitar</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>

        <!-- Scripts -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
        <script src="../assets/js/scripts.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.datatables.net/2.0.2/js/dataTables.js"></script>
        <script src="../assets/js/filtro-avisos-bundle.js"></script>

        <!-- Script de filtrado dinámico por fecha -->
        <script>
            //Capturamos el select y guardamos todas las opciones
            const selectActividad = document.getElementById('actividadId');
            const originalOptions = Array.from(selectActividad.options).map(opt => ({
              value: opt.value,
              text:  opt.textContent.trim(),
              fecha: opt.getAttribute('meeting_fecha')
            }));
          
            //Repoblación del select según la fecha seleccionada
            function filtrarClasesPorFecha(fecha) {
              selectActividad.innerHTML = '';
              const filtradas = originalOptions.filter(o => o.fecha === fecha);
          
              if (filtradas.length === 0) {
                document.getElementById('no-clases-msg').style.display = 'block';
                selectActividad.disabled = true;
              } else {
                document.getElementById('no-clases-msg').style.display = 'none';
                selectActividad.disabled = false;
                filtradas.forEach(o => {
                  const opt = document.createElement('option');
                  opt.value       = o.value;
                  opt.textContent = o.text;
                  selectActividad.appendChild(opt);
                });
              }
            }
          
            //comprobamos camvios en meeting_time
            document.getElementById('meeting_time').addEventListener('change', e => {
              filtrarClasesPorFecha(e.target.value);
            });
          
            //agregamos el listener al cargar la página
            window.addEventListener('DOMContentLoaded', () => {
              filtrarClasesPorFecha(document.getElementById('meeting_time').value);
            });
          </script>
          
    </body>
</html>
