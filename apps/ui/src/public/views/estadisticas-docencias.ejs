<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Estadísticas de Docencias</title>
        <%- include('Plantillas/plantilla-head-html.ejs') %>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/css/select2.min.css" rel="stylesheet">
        <link href="https://cdn.datatables.net/2.0.2/css/dataTables.dataTables.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="/assets/css/styles-tfg.css">
</head>
<body class="sb-nav-fixed">
     <!--barra de navegacion -->
    <%- include('Plantillas/plantilla-nav-var.ejs') %>
    <div id="layoutSidenav">
        <!-- Plantilla de sidevar-->
        <%- include('Plantillas/plantilla-layout-sidevar.ejs')%>
        <div id="layoutSidenav_content">

            <main>
                <div class="estadisticas-titulos">
                    <h1 class="titulo-centrado">Estadísticas de Docencias</h1>
                    <p class="titulo-centrado">Periodo: <%= fechaInicio %> a <%= fechaFin %></p>
                </div>

                <div class="estadisticas-row">
                    <div class="estadistica-card">
                        <h2>Porcentaje de Asistencias</h2>
                        <canvas id="asistenciasChart"></canvas>
                    </div>
                    <div class="estadistica-card barra">
                        <h2>Top 5 Departamentos con más incidencias</h2>
                        <canvas id="departamentosChart"></canvas>
                    </div>
                </div>

                <div class="estadisticas-row">
                    <div class="estadistica-card">
                        <h2>Excepciones en el periodo</h2>
                        <canvas id="excepcionesTipoChart" width="300" height="300"></canvas>
                    </div>
                    <div class="estadistica-card barra">
                        <h2>Top 5 asignaturas con más excepciones</h2>
                        <canvas id="topActividadesChart" width="400" height="300"></canvas>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <script>
    </script>

    <script>
        // Datos para el gráfico de asistencias
        const asistenciasData = {
            labels: ['Asistidas', 'No Asistidas', 'Irregularidades'],
            datasets: [{
                label: 'Nº de asistencias',
                data: [<%- datosAsistencias.asistidas %>, <%- datosAsistencias.noAsistidas %>, <%- datosAsistencias.irregularidades %>],
                backgroundColor: ['#4CAF50', '#F44336', '#FFC107']
            }]
        };

        const asistenciasConfig = {
            type: 'pie',
            data: asistenciasData
        };

        new Chart(document.getElementById('asistenciasChart'), asistenciasConfig);

        // --- TOP 5 Departamentos con más incidencias (EJS-safe) ---
  const resumenDept = <%- JSON.stringify(
    typeof incidenciasPorDepartamento !== 'undefined' ? incidenciasPorDepartamento : []
  ) %>;

  // Ordena por total_incidencias desc y toma Top-5
  const top5Dept = resumenDept
    .slice()
    .sort((a, b) => b.total_incidencias - a.total_incidencias)
    .slice(0, 5);

  const departamentosLabels = top5Dept.map(d => d.departamento_nombre);
  const departamentosData   = top5Dept.map(d => d.total_incidencias);

  const ctxDept = document.getElementById('departamentosChart');

  if (ctxDept && top5Dept.length > 0) {
    new Chart(ctxDept, {
      type: 'doughnut', // cambia a 'doughnut' si prefieres donut
      data: {
        labels: departamentosLabels,
        datasets: [{
          label: 'Incidencias',
          data: departamentosData,
          backgroundColor: ['#1976d2', '#388e3c', '#fbc02d', '#d32f2f', '#7b1fa2']
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: true, position: 'top', align: 'start' },
          tooltip: { enabled: true }
        }
      }
    });
  } else if (ctxDept) {
    // Mensaje si no hay datos
    const p = document.createElement('p');
    p.textContent = 'No hay incidencias para mostrar.';
    ctxDept.replaceWith(p);
  }

        // Gráfico de donut: Canceladas vs Reprogramadas
        const datosExcepciones = <%- JSON.stringify(datosExcepciones) %>;
        const excepcionesTipoData = {
            labels: Object.keys(datosExcepciones),
            datasets: [{
                label: 'Nº de excepciones',
                data: Object.values(datosExcepciones),
                backgroundColor: ['#F44336', '#FFC107']
            }]
        };
        new Chart(document.getElementById('excepcionesTipoChart'), {
            type: 'doughnut',
            data: excepcionesTipoData
        });

        const topActividadesLabels = <%- JSON.stringify(topActividadesLabels) %>;
  const topActividadesData   = <%- JSON.stringify(topActividadesData) %>;

    new Chart(document.getElementById('topActividadesChart'), {
        type: 'bar',
        data: {
        labels: topActividadesLabels,
        datasets: [{
            label: 'Nº de excepciones',
            data: topActividadesData,
            backgroundColor: ['#1976d2', '#388e3c', '#fbc02d', '#d32f2f', '#7b1fa2']
        }]
        },
        options: {
        plugins: {
            legend: { display: false }, // <- oculta la leyenda (rectángulo azul)
            // title: { display: false } // por si tuvieras título del plugin
        }
        }
    });
    </script>
</body>
</html>