<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Añadir una MAC - ASD</title>
                <!--Cabecera comun de head-->
        <%- include('Plantillas/plantilla-head-html.ejs') %>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/css/select2.min.css" rel="stylesheet">
        
    </head>
    <body class="sb-nav-fixed">
        <!--barra de navegacion -->
        <%- include('Plantillas/plantilla-nav-var.ejs') %>
        <div id="layoutSidenav">
            <!-- Plantilla de sidevar-->
            <%- include(Plantillas/plantilla-layout.sidevar.ejs)%>
            <div id="layoutSidenav_content">
                <main>
                    <!-- espacio necesario para que el navbar no se coma parte de los datos -->
                    <div class="container-fluid px-4"> 
                        <ol class="breadcrumb mb-4 py-4">
                            <li class="breadcrumb-item"><a href="/">Página principal</a></li>
                            <li class="breadcrumb-item active">Añadir una MAC</li>
                        </ol>
                        <div class="row justify-content-center" id="feature-div">
                        <!-- separar de arriba, en xs 11 columnas, en s 10 columnas, etc. -->
                            <div class="col-11 col-sm-10 col-md-8 col-lg-6"><div class="card shadow-lg border-0 rounded-lg mt-5">
                                <div class="card-header"><h3 class="text-center font-weight-light my-3">Formulario</h3></div>
                                <div class="card-body">
                                    <% if (typeof error != 'undefined') { %>
                                    <p class="text-error"><%= error.error %></p>
                                    <% } %>
                                    <div>
                                        <form method="post" id="formulario"> 
                                            <div class="form-floating mb-3" id="div_mac1">
                                                <input type="text" class="form-control" name="mac1" id="mac1" value="" pattern="^([0-9a-fA-F]{2}[:]){5}([0-9a-fA-F]{2})$" required/>
                                                <label for="mac1">MAC</label>
                                            </div>
                                            <a class="btn btn-primary" id="add-mac-button">
                                                <i class="fas fa-circle-plus"></i>
                                            </a>
                                            <a class="btn btn-primary disabled" id="remove-mac-button">
                                                <i class="fas fa-circle-minus"></i>
                                            </a>
                                            <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                                <a class="btn btn-primary" href="/">Atrás</a>
                                                <button class="btn btn-primary" type="submit">OK</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
        <script src="../assets/js/scripts.min.js"></script>
        <script src="../assets/js/add-mac-field.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/js/select2.min.js"></script>
        <script>
            $(document).ready(function() {
                // Initialize Select2
                var select2 = $('.select').select2();
            });
        </script>
    </body>
</html>