<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Registrar asistencia - ASD</title>
                <!--Cabecera comun de head-->
        <%- include('Plantillas/plantilla-head-html.ejs') %>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/css/select2.min.css" rel="stylesheet">
    </head>
    <body class="sb-nav-fixed">
        <!--barra de navegacion -->
        <%- include('Plantillas/plantilla-nav-var.ejs') %>
        <div id="layoutSidenav">
            <!-- Plantilla de sidevar-->
            <%- include('Plantillas/plantilla-layout-sidevar.ejs')%>
            <div id="layoutSidenav_content">
                <main>
                    <!-- espacio necesario para que el navbar no se coma parte de los datos -->
                    <div class="container-fluid px-4"> 
                        <ol class="breadcrumb mb-4 py-4">
                            <li class="breadcrumb-item"><a href="/">Página principal</a></li>
                            <li class="breadcrumb-item"><a href="formulario-aulas"></a>Aulas</li>
                            <li class="breadcrumb-item active">Registrar asistencia</li>
                        </ol>
                        <div class="row justify-content-center" id="feature-div">
                        <!-- separar de arriba, en xs 11 columnas, en s 10 columnas, etc. -->
                            <div class="col-11 col-sm-10 col-md-8 col-lg-6">
                                <div class="card shadow-lg border-0 rounded-lg mt-5">
                                    <div class="card-header"><h3 class="text-center font-weight-light my-3">Formulario</h3></div>
                                    <div class="card-body">
                                        <% if (typeof error != 'undefined') { %>
                                        <p class="text-error"><%= error %></p>
                                        <% } %>
                                        <form method="post"> 
                                            <div class="form-floating mb-3">
                                                <input type="text" class="form-control" name="docente" id="docente" value="<%= usuario.nombre %> <%= usuario.apellidos %>" readonly/>
                                                <label for="docente">Docente</label>
                                            </div>
                                            <div class="form-floating mb-3">
                                                <input type="hidden" name="clases" value="<%= JSON.stringify(resultado.clases) %>">
                                                <select class="select form-control" name="asignatura" id="clase" readonly>
                                                    <% resultado.clases.forEach(function(clase) { %>
                                                        <option value="<%= clase.asignatura %> <%= clase.grupo %>"> <%= clase.asignatura %> <%= clase.grupo %> </option>
                                                    <% }); %>
                                                </select>
                                                <label for="clase">Asignatura y Grupo</label>
                                            </div>
                                            <div class="form-floating mb-3">
                                                <input type="text" class="form-control" name="espacio" id="espacio" value="<%= resultado.espacio %>" readonly/>
                                                <label for="espacio">Aula / Laboratorio</label>
                                            </div>
                                            <div class="form-floating mb-3">
                                                <input type="number" pattern="[0-9]{6}" class="form-control" name="totp" id="totp" value="<%= resultado.totp %>"/>
                                                <label for="totp">TOTP</label>
                                            </div>
                                            <div class="form-floating mb-3">
                                                <input type="time" class="form-control" name="hora" id="hora" value="<%= resultado.hora %>" readonly/>
                                                <label for="hora">Hora</label>
                                            </div>
                                            <% if (irregularidad) {%>
                                                <div class="form-check">
                                                    <input type="checkbox" name="sustitucion" class="form-check-input" id="sustitucion">
                                                    <label class="form-check-label" for="sustitucion">Es una sustitución</label>
                                                </div>
                                                <div class="form-check">
                                                    <input type="checkbox" name="claseMov" class="form-check-input" id="claseMov">
                                                    <label class="form-check-label" for="claseMov">Cambio de aula</label>
                                                </div>
                                            <% } %>
                                            <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                                <a class="btn btn-primary" href="../formulario-aulas">Atrás</a>
                                                <button class="btn btn-primary" type="submit">OK</a>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
        <script src="../assets/js/scripts.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/js/select2.min.js"></script>
        <script>
            $(document).ready(function() {
                // Initialize Select2
                var select2 = $('.select').select2();
            });
        </script>
    </body>
</html>