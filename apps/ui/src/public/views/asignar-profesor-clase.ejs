<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Gestión de intercambio de clases- ASD</title>
                <!--Cabecera comun de head-->
        <%- include('Plantillas/plantilla-head-html.ejs') %>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/css/select2.min.css" rel="stylesheet">
        <link href="https://cdn.datatables.net/2.0.2/css/dataTables.dataTables.css" rel="stylesheet" />
        
    </head>
    <body class="sb-nav-fixed">
        <!--barra de navegacion -->
        <%- include('Plantillas/plantilla-nav-var.ejs') %>
        <div id="layoutSidenav">
            <!-- Plantilla de sidevar-->
            <%- include('Plantillas/plantilla-layout-sidevar.ejs')%>
            <div id="layoutSidenav_content">
                <main>
                    <div class="container-fluid px-4">
                        <ol class="breadcrumb mb-4 py-4">
                            <li class="breadcrumb-item"><a href="/">Página principal</a></li>
                            <li class="breadcrumb-item"><a href="/gestion-cambio-clase">Gestión de cambio de clases</a></li>
                            <li class="breadcrumb-item active">Asignar profesor sustituto</li>
                        </ol>
                        <div class="row justify-content-center" id="feature-div">
                        <!-- separar de arriba, en xs 11 columnas, en s 10 columnas, etc. -->
                            <div class="col-11 col-sm-10 col-md-8 col-lg-6">
                                <div class="card shadow-lg border-0 rounded-lg mt-5">
                                    <div class="card-header"><h3 class="text-center font-weight-light my-3">Formulario</h3></div>
                                    <div class="card-body">
                                        <% if (typeof error != 'undefined') { %>
                                        <p class="text-error"><%= error %></p>
                                        <% } %>
                                        <form method="post"> 
                                                <div class="form-floating mb-3">
                                                    <div class="form-floating mb-3">
                                                    <input type="date" class="form-control" id="meeting_time" name="meeting_time" value="<%= fecha.hoy %>" min="<%= fecha.hoy %>" max="<%= fecha.max %>"/>
                                                    <label for="meeting_time">Fecha</label>
                                                </div>

                                                <div class="form-floating mb-3">
                                                    <select class="form-control" id="actividadId" name="actividadId" required>
                                                        <% clases.forEach(function(clase) { %>
                                                            <option value="<%= clase.id %>" fecha="<%= clase.fecha %>"> <%= clase.nombre %></option>
                                                        <% }); %>
                                                    </select>
                                                    <label for="actividadId">Asignatura y Grupo</label>
                                                </div>
                                                <div class="form-floating mb-3">
                                                    <select class="select form-control" name="sustituto" id="inputName">
                                                        <% docentes.forEach(function(docente) { %>
                                                            <option value="<%= docente.id %>"><%= docente.nombre %> <%= docente.apellidos %></option>
                                                        <% }); %>
                                                    </select>
                                                    <label for="inputName">Nombre del profesor suplente</label>
                                                    <ul id="suggestions" style="border:1px solid #ccc; display:none; position:absolute; background:#fff; list-style:none; margin:0; padding:0; width:200px;"></ul>
                                                </div>
                                                
                                            </div>
                                            <div class="d-flex align-items-center justify-content-between mt-4 mb-0">
                                                <a class="btn btn-primary" href="/gestion-cambio-clase">Atrás</a>
                                                <button class="btn btn-primary" type="submit">OK</a>
                                            </div>

                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
        <script src="../assets/js/scripts.min.js"></script>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdn.datatables.net/2.0.2/js/dataTables.js"></script>
        <script src="../assets/js/filtro-sustitucion.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.3/js/select2.min.js"></script>
    </body>
</html>